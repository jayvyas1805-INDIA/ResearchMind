# --- General ---
ENVIRONMENT=development
DEBUG=True

# --- CORS (comma-separated list is NOT supported by pydantic list parsing by default;
# for multiple origins, edit CORS_ORIGINS in app/core/config.py directly, or set as JSON array below) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Database ---
DATABASE_URL=sqlite:///./data/papermind.db

# --- Storage ---
UPLOAD_DIR=./data/uploads
INDEX_DIR=./indexes
MAX_UPLOAD_SIZE_MB=25

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Chunking ---
CHUNK_TARGET_WORDS=180
CHUNK_MIN_WORDS=40

# --- Retrieval ---
DEFAULT_TOP_K=5

# --- LLM provider: ollama | openai | gemini ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Only needed if you switch LLM_PROVIDER to a cloud provider:
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Groundedness checking (NLI-based hallucination detection) ---
GROUNDEDNESS_CHECK_ENABLED=True
NLI_MODEL=cross-encoder/nli-deberta-v3-small
GROUNDEDNESS_SUPPORT_THRESHOLD=0.5
GROUNDEDNESS_SENTENCE_RATIO_THRESHOLD=0.6
